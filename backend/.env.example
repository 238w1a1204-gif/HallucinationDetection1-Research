# ==========================================================
# Hallucination Detection & Answer Verification - Environment
# ==========================================================
# Copy this file to `.env` in the backend/ folder and fill in
# values as needed. Nothing here is required to run the app
# with the default local Hugging Face provider.

# ---- LLM Provider ----
# Options: "huggingface" (default, local, no key needed), "gemini", "openai"
LLM_PROVIDER=huggingface

# Local Hugging Face text-generation model (downloaded automatically on first run)
HF_GENERATION_MODEL=google/flan-t5-base

# Only needed if LLM_PROVIDER=gemini
GEMINI_API_KEY=AQ.Ab8RN6IXXxIvfpWzYMwKG4QT4p89zCw-e0MH9UC4p8Pw9jL4Eg
GEMINI_MODEL=gemini-1.5-flash

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- NLP models ----
SPACY_MODEL=en_core_web_sm
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL=facebook/bart-large-mnli

# ---- Verification thresholds (starting values, not scientifically validated) ----
SIMILARITY_STRONG_THRESHOLD=0.75
SIMILARITY_PARTIAL_THRESHOLD=0.55
AGREEMENT_MIN_SOURCES=2

# ---- Confidence score weights (heuristic, tunable) ----
CONFIDENCE_WEIGHT_SIMILARITY=0.5
CONFIDENCE_WEIGHT_AGREEMENT=0.3
CONFIDENCE_WEIGHT_CONSISTENCY=0.2

# ---- Database ----
DATABASE_URL=sqlite:///./hallucination_detection.db

# ---- Retrieval ----
RETRIEVAL_TIMEOUT_SECONDS=8
RETRIEVAL_MAX_RESULTS_PER_SOURCE=3

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173
